# This GitHub repository is intentionally content-only.
# Ignore the Android library and all local/generated files by default, then
# explicitly allow only the remote content and its publishing configuration.
*

!.gitignore
!library.json

!.github/
!.github/workflows/
!.github/workflows/publish-content.yml

!content/
!content/**

# Never publish macOS metadata from content directories.
.DS_Store
